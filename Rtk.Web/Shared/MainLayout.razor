@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="_modernTheme" IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout Class="app-shell">
    <MudAppBar Elevation="0" Class="app-topbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h5" Class="ml-3">🛰️ RTKLib 云解算平台</MudText>
        <MudSpacer />
        <MudTooltip Text="@(_isDarkMode ? "切换为浅色模式" : "切换为深色模式")">
            <MudIconButton
                Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                Color="Color.Inherit"
                OnClick="ToggleTheme" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive" Class="app-drawer">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">首页</MudNavLink>
            <MudNavLink Href="/spp" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.GpsFixed">SPP</MudNavLink>
            <MudNavLink Href="/ppp" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Public">PPP</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="app-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDarkMode;
    private bool _drawerOpen = true;
    private readonly MudTheme _modernTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563eb",
            Secondary = "#14b8a6",
            Background = "#f8fafc",
            Surface = "#ffffff",
            AppbarBackground = "#1e3a8a",
            AppbarText = "#f8fafc",
            DrawerBackground = "#ffffff",
            DrawerText = "#0f172a",
            DrawerIcon = "#64748b"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#60a5fa",
            Secondary = "#2dd4bf",
            Background = "#0b1120",
            Surface = "#111827",
            AppbarBackground = "#0b1120",
            AppbarText = "#e2e8f0",
            DrawerBackground = "#0f172a",
            DrawerText = "#e2e8f0",
            DrawerIcon = "#94a3b8"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "14px"
        }
    };

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
