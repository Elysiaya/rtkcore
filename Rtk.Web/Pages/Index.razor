@page "/"
<MudPaper Elevation="0" Class="home-hero pa-6 mb-4">
    <MudText Typo="Typo.h3" HtmlTag="h1">首页</MudText>
    <MudText Typo="Typo.body1" Class="mt-2">
        欢迎使用 RTK 解算平台，请通过左侧菜单进入 SPP 或 PPP 页面开始任务。
    </MudText>
</MudPaper>

<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <MudCard Class="home-card" Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">SPP 页面</MudText>
                    <MudText Typo="Typo.caption">单点定位工作台</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">上传观测/导航数据，配置 SPP 参数并提交任务。</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/spp">进入 SPP</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard Class="home-card" Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">PPP 页面</MudText>
                    <MudText Typo="Typo.caption">精密单点定位工作台</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">上传精密产品文件，配置 PPP 参数并提交任务。</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/ppp">进入 PPP</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>
